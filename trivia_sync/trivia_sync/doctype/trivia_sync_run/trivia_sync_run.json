{
  "doctype": "DocType",
  "name": "Trivia Sync Run",
  "autoname": "hash",
  "module": "Trivia Sync",
  "read_only": 1,
  "field_order": [
    "source",
    "operation",
    "status",
    "started_at",
    "finished_at",
    "page",
    "records_created",
    "records_updated",
    "records_skipped",
    "records_errors",
    "records_received",
    "endpoint_metrics",
    "error_log",
    "operator",
    "parameters_json",
    "request_budget",
    "credit_reserve",
    "requests_made",
    "credits_used",
    "current_operation",
    "resume_operation",
    "resume_page"
  ],
  "fields": [
    {
      "fieldname": "source",
      "fieldtype": "Select",
      "label": "Source",
      "options": "QAPI\nFrappe LMS\nIA",
      "in_list_view": 1
    },
    {
      "fieldname": "operation",
      "fieldtype": "Select",
      "label": "Operation",
      "options": "Pull questions\nPush LMS content\nFull QAPI sync\nQAPI ingestion\nAI enrichment",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Queued\nRunning\nCompleted\nPartial\nFailed\nBlocked",
      "in_list_view": 1
    },
    {
      "fieldname": "started_at",
      "fieldtype": "Datetime",
      "label": "Started at"
    },
    {
      "fieldname": "finished_at",
      "fieldtype": "Datetime",
      "label": "Finished at"
    },
    {
      "fieldname": "page",
      "fieldtype": "Int",
      "label": "Last page"
    },
    {
      "fieldname": "records_created",
      "fieldtype": "Int",
      "label": "Created"
    },
    {
      "fieldname": "records_updated",
      "fieldtype": "Int",
      "label": "Updated"
    },
    {
      "fieldname": "records_skipped",
      "fieldtype": "Int",
      "label": "Skipped"
    },
    {
      "fieldname": "records_errors",
      "fieldtype": "Int",
      "label": "Errors"
    },
    {
      "fieldname": "records_received",
      "fieldtype": "Int",
      "label": "Records received",
      "read_only": 1
    },
    {
      "fieldname": "endpoint_metrics",
      "fieldtype": "Code",
      "label": "Metrics by endpoint",
      "options": "JSON",
      "read_only": 1
    },
    {
      "fieldname": "error_log",
      "fieldtype": "Long Text",
      "label": "Error log"
    },
    {
      "fieldname": "operator",
      "fieldtype": "Link",
      "label": "Operator",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "parameters_json",
      "fieldtype": "Code",
      "label": "Parameters",
      "options": "JSON",
      "read_only": 1
    },
    {
      "fieldname": "request_budget",
      "fieldtype": "Int",
      "label": "Credit budget",
      "read_only": 1
    },
    {
      "fieldname": "credit_reserve",
      "fieldtype": "Int",
      "label": "Reserve applied",
      "read_only": 1
    },
    {
      "fieldname": "requests_made",
      "fieldtype": "Int",
      "label": "Requests made",
      "read_only": 1
    },
    {
      "fieldname": "credits_used",
      "fieldtype": "Int",
      "label": "Credits used",
      "read_only": 1
    },
    {
      "fieldname": "current_operation",
      "fieldtype": "Data",
      "label": "Current operation",
      "read_only": 1
    },
    {
      "fieldname": "resume_operation",
      "fieldtype": "Data",
      "label": "Resume operation",
      "read_only": 1
    },
    {
      "fieldname": "resume_page",
      "fieldtype": "Int",
      "label": "Resume page",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "Trivia Editor",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trivia Reviewer",
      "read": 1,
      "write": 1,
      "create": 0
    },
    {
      "role": "Trivia Integrator",
      "read": 1
    }
  ]
}
