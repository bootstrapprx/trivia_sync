{
  "doctype": "DocType",
  "name": "Prova",
  "autoname": "field:qapi_id",
  "module": "Trivia Sync",
  "title_field": "titulo",
  "track_changes": 1,
  "field_order": [
    "identity_section",
    "qapi_id",
    "titulo",
    "concurso",
    "banca",
    "orgao",
    "cargo",
    "ano",
    "pdf_url",
    "raw_payload",
    "sync_hash",
    "last_synced_at",
    "source_type",
    "source_id",
    "source_key",
    "prova_type",
    "status",
    "concurso_cargo",
    "lms_course",
    "lms_lesson",
    "lms_quiz",
    "duration_minutes",
    "exam_version",
    "exam_blocks",
    "exam_questions",
    "requested_questions",
    "blueprint_hash",
    "exam_versions"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "fieldtype": "Section Break",
      "label": "Identificação"
    },
    {
      "fieldname": "qapi_id",
      "fieldtype": "Data",
      "label": "ID QAPI",
      "reqd": 1
    },
    {
      "fieldname": "titulo",
      "fieldtype": "Data",
      "label": "Título",
      "reqd": 1
    },
    {
      "fieldname": "concurso",
      "fieldtype": "Link",
      "label": "Concurso",
      "options": "Concurso"
    },
    {
      "fieldname": "banca",
      "fieldtype": "Data",
      "label": "Banca"
    },
    {
      "fieldname": "orgao",
      "fieldtype": "Data",
      "label": "Órgão"
    },
    {
      "fieldname": "cargo",
      "fieldtype": "Data",
      "label": "Cargo"
    },
    {
      "fieldname": "ano",
      "fieldtype": "Int",
      "label": "Ano"
    },
    {
      "fieldname": "pdf_url",
      "fieldtype": "Data",
      "label": "PDF"
    },
    {
      "fieldname": "raw_payload",
      "fieldtype": "Code",
      "label": "Payload bruto",
      "options": "JSON",
      "hidden": 1
    },
    {
      "fieldname": "sync_hash",
      "fieldtype": "Data",
      "label": "Hash"
    },
    {
      "fieldname": "last_synced_at",
      "fieldtype": "Datetime",
      "label": "Última sincronização"
    },
    {
      "fieldname": "source_type",
      "fieldtype": "Data",
      "label": "Tipo de fonte",
      "default": "QAPI"
    },
    {
      "fieldname": "source_id",
      "fieldtype": "Data",
      "label": "ID na fonte"
    },
    {
      "fieldname": "source_key",
      "fieldtype": "Data",
      "label": "Chave estável da fonte",
      "unique": 1
    },
    {
      "fieldname": "prova_type",
      "fieldtype": "Select",
      "label": "Tipo",
      "options": "Official\nPractice",
      "default": "Official"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Estado",
      "options": "Draft\nReady\nPublished\nSuperseded\nArchived",
      "default": "Draft",
      "in_standard_filter": 1
    },
    {
      "fieldname": "concurso_cargo",
      "fieldtype": "Link",
      "label": "Cargo do concurso",
      "options": "Concurso Cargo"
    },
    {
      "fieldname": "lms_course",
      "fieldtype": "Link",
      "label": "Curso LMS",
      "options": "LMS Course"
    },
    {
      "fieldname": "lms_lesson",
      "fieldtype": "Link",
      "label": "Aula LMS",
      "options": "Course Lesson"
    },
    {
      "fieldname": "lms_quiz",
      "fieldtype": "Link",
      "label": "Quiz LMS",
      "options": "LMS Quiz",
      "read_only": 1
    },
    {
      "fieldname": "duration_minutes",
      "fieldtype": "Int",
      "label": "Duração (minutos)"
    },
    {
      "fieldname": "exam_version",
      "fieldtype": "Int",
      "label": "Versão",
      "default": "1",
      "read_only": 1
    },
    {
      "fieldname": "exam_blocks",
      "fieldtype": "Table",
      "label": "Blocos",
      "options": "Trivia Exam Block"
    },
    {
      "fieldname": "exam_questions",
      "fieldtype": "Table",
      "label": "Questões",
      "options": "Trivia Exam Question"
    },
    {
      "fieldname": "requested_questions",
      "fieldtype": "Int",
      "label": "Questões solicitadas"
    },
    {
      "fieldname": "blueprint_hash",
      "fieldtype": "Data",
      "label": "Hash do blueprint"
    },
    {
      "fieldname": "exam_versions",
      "fieldtype": "Table",
      "label": "Versões do simulado",
      "options": "Trivia Exam Version"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Trivia Editor",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trivia Reviewer",
      "read": 1,
      "write": 1,
      "create": 0
    },
    {
      "role": "Trivia Integrator",
      "read": 1,
      "write": 1,
      "create": 0
    }
  ]
}
