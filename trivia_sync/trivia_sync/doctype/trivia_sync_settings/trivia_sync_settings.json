{
  "doctype": "DocType",
  "name": "Trivia Sync Settings",
  "issingle": 1,
  "module": "Trivia Sync",
  "editable_grid": 1,
  "field_order": [
    "qapi_section",
    "qapi_base_url",
    "qapi_api_key",
    "qapi_enabled",
    "qapi_sync_frequency",
    "qapi_page_size",
    "qapi_max_pages",
    "qapi_min_credit_reserve",
    "qapi_max_requests_per_run",
    "lms_section",
    "lms_sync_enabled",
    "lms_sync_frequency",
    "trivia_api_url",
    "trivia_api_token",
    "trivia_sync_mode",
    "only_published",
    "audit_section",
    "last_qapi_sync_at",
    "last_lms_sync_at",
    "catalog_section",
    "sync_catalogs",
    "sync_support_texts",
    "sync_exams",
    "sync_flashcards",
    "push_flashcards",
    "qapi_timeout",
    "mcp_enabled",
    "mcp_base_url",
    "ai_section",
    "ai_enabled",
    "ai_base_url",
    "ai_api_key",
    "ai_model",
    "ai_timeout",
    "ai_batch_size"
  ],
  "fields": [
    {
      "fieldname": "qapi_section",
      "fieldtype": "Section Break",
      "label": "QAPI · contest questions"
    },
    {
      "fieldname": "qapi_base_url",
      "fieldtype": "Data",
      "label": "QAPI base URL",
      "default": "https://qapi.otunac.com/api",
      "reqd": 1
    },
    {
      "fieldname": "qapi_api_key",
      "fieldtype": "Password",
      "label": "Q-Api-Key",
      "description": "Never expose this key in the frontend or repository."
    },
    {
      "fieldname": "qapi_enabled",
      "fieldtype": "Check",
      "label": "Enable QAPI sync",
      "default": "0"
    },
    {
      "fieldname": "qapi_sync_frequency",
      "fieldtype": "Select",
      "label": "QAPI frequency",
      "options": "Hourly\nEvery scheduler tick",
      "default": "Hourly"
    },
    {
      "fieldname": "qapi_page_size",
      "fieldtype": "Int",
      "label": "Items per page",
      "default": "10",
      "description": "QAPI list endpoints are limited to 10 items per page."
    },
    {
      "fieldname": "qapi_max_pages",
      "fieldtype": "Int",
      "label": "Max pages per run",
      "default": "10"
    },
    {
      "fieldname": "lms_section",
      "fieldtype": "Section Break",
      "label": "Frappe LMS → Trivia"
    },
    {
      "fieldname": "lms_sync_enabled",
      "fieldtype": "Check",
      "label": "Enable LMS sync",
      "default": "0"
    },
    {
      "fieldname": "lms_sync_frequency",
      "fieldtype": "Select",
      "label": "LMS frequency",
      "options": "Daily\nEvery scheduler tick",
      "default": "Daily"
    },
    {
      "fieldname": "trivia_api_url",
      "fieldtype": "Data",
      "label": "Trivia360 API URL",
      "description": "Endpoint que recebe o payload normalizado de cursos existentes do LMS."
    },
    {
      "fieldname": "trivia_api_token",
      "fieldtype": "Password",
      "label": "Trivia360 API token"
    },
    {
      "fieldname": "trivia_sync_mode",
      "fieldtype": "Select",
      "label": "Delivery mode",
      "options": "Push normalized payload\nDry run",
      "default": "Push normalized payload"
    },
    {
      "fieldname": "only_published",
      "fieldtype": "Check",
      "label": "Send published courses only",
      "default": "1"
    },
    {
      "fieldname": "audit_section",
      "fieldtype": "Section Break",
      "label": "Audit"
    },
    {
      "fieldname": "last_qapi_sync_at",
      "fieldtype": "Datetime",
      "label": "Last QAPI sync",
      "read_only": 1
    },
    {
      "fieldname": "last_lms_sync_at",
      "fieldtype": "Datetime",
      "label": "Last LMS sync",
      "read_only": 1
    },
    {
      "fieldname": "catalog_section",
      "fieldtype": "Section Break",
      "label": "QAPI catalogs and resources"
    },
    {
      "fieldname": "sync_catalogs",
      "fieldtype": "Check",
      "label": "Sync catalogs",
      "default": "1"
    },
    {
      "fieldname": "sync_support_texts",
      "fieldtype": "Check",
      "label": "Sync supporting texts and link to questions",
      "default": "1"
    },
    {
      "fieldname": "sync_exams",
      "fieldtype": "Check",
      "label": "Sync exams (200 credits per call)",
      "default": "0"
    },
    {
      "fieldname": "sync_flashcards",
      "fieldtype": "Check",
      "label": "Sync flashcards",
      "default": "1"
    },
    {
      "fieldname": "push_flashcards",
      "fieldtype": "Check",
      "label": "Create local flashcards in QAPI",
      "default": "0",
      "description": "Only Flashcard records with source type LOCAL are sent to QAPI."
    },
    {
      "fieldname": "qapi_timeout",
      "fieldtype": "Int",
      "label": "HTTP timeout (seconds)",
      "default": "60"
    },
    {
      "fieldname": "mcp_enabled",
      "fieldtype": "Check",
      "label": "Enable MCP fallback",
      "default": "0"
    },
    {
      "fieldname": "mcp_base_url",
      "fieldtype": "Data",
      "label": "MCP base URL",
      "default": "https://qapi.otunac.com/mcp"
    },
    {
      "fieldname": "ai_section",
      "fieldtype": "Section Break",
      "label": "AI adapter · question enrichment"
    },
    {
      "fieldname": "ai_enabled",
      "fieldtype": "Check",
      "label": "Enable AI enrichment",
      "default": "0",
      "description": "AI enrichment is opt-in and consumes requests from the configured provider."
    },
    {
      "fieldname": "ai_base_url",
      "fieldtype": "Data",
      "label": "AI base URL",
      "default": "https://api.openai.com/v1"
    },
    {
      "fieldname": "ai_api_key",
      "fieldtype": "Password",
      "label": "AI provider key",
      "description": "Never expose this key in the frontend or repository."
    },
    {
      "fieldname": "ai_model",
      "fieldtype": "Data",
      "label": "AI model",
      "default": "gpt-6-luna"
    },
    {
      "fieldname": "ai_timeout",
      "fieldtype": "Int",
      "label": "AI timeout (seconds)",
      "default": "90"
    },
    {
      "fieldname": "ai_batch_size",
      "fieldtype": "Int",
      "label": "Questions per AI run",
      "default": "10",
      "description": "Safety limit for each manual run or worker."
    },
    {
      "fieldname": "qapi_max_requests_per_run",
      "fieldtype": "Int",
      "label": "Max QAPI credits per run",
      "default": "0",
      "description": "0 blocks paid requests. Exam requests cost 200 credits; all others cost 1. The reserve is deducted from this limit."
    },
    {
      "fieldname": "qapi_min_credit_reserve",
      "fieldtype": "Int",
      "label": "Minimum QAPI credit reserve",
      "default": "1",
      "description": "Credits held in reserve and unavailable to the run."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "Trivia Editor",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trivia Reviewer",
      "read": 1,
      "write": 1,
      "create": 0
    }
  ]
}
