{
  "doctype": "DocType",
  "name": "Trivia Sync Settings",
  "issingle": 1,
  "module": "Trivia Sync",
  "editable_grid": 1,
  "field_order": [
    "qapi_section",
    "qapi_base_url",
    "qapi_api_key",
    "qapi_enabled",
    "qapi_sync_frequency",
    "qapi_page_size",
    "qapi_max_pages",
    "qapi_min_credit_reserve",
    "qapi_max_requests_per_run",
    "lms_section",
    "lms_sync_enabled",
    "lms_sync_frequency",
    "trivia_api_url",
    "trivia_api_token",
    "trivia_sync_mode",
    "only_published",
    "audit_section",
    "last_qapi_sync_at",
    "last_lms_sync_at",
    "catalog_section",
    "sync_catalogs",
    "sync_support_texts",
    "sync_exams",
    "sync_flashcards",
    "qapi_timeout",
    "mcp_enabled",
    "mcp_base_url",
    "ai_section",
    "ai_enabled",
    "ai_base_url",
    "ai_api_key",
    "ai_model",
    "ai_timeout",
    "ai_batch_size"
  ],
  "fields": [
    {
      "fieldname": "qapi_section",
      "fieldtype": "Section Break",
      "label": "QAPI · questões de concursos"
    },
    {
      "fieldname": "qapi_base_url",
      "fieldtype": "Data",
      "label": "QAPI base URL",
      "default": "https://qapi.otunac.com/api",
      "reqd": 1
    },
    {
      "fieldname": "qapi_api_key",
      "fieldtype": "Password",
      "label": "Q-Api-Key",
      "description": "Nunca exponha esta chave no frontend ou no repositório."
    },
    {
      "fieldname": "qapi_enabled",
      "fieldtype": "Check",
      "label": "Ativar sincronização QAPI",
      "default": "0"
    },
    {
      "fieldname": "qapi_sync_frequency",
      "fieldtype": "Select",
      "label": "Frequência QAPI",
      "options": "Hourly\nEvery scheduler tick",
      "default": "Hourly"
    },
    {
      "fieldname": "qapi_page_size",
      "fieldtype": "Int",
      "label": "Itens por página",
      "default": "10",
      "description": "A QAPI limita listagens a 10 itens por página."
    },
    {
      "fieldname": "qapi_max_pages",
      "fieldtype": "Int",
      "label": "Máximo de páginas por execução",
      "default": "10"
    },
    {
      "fieldname": "lms_section",
      "fieldtype": "Section Break",
      "label": "Frappe LMS → trivia"
    },
    {
      "fieldname": "lms_sync_enabled",
      "fieldtype": "Check",
      "label": "Ativar sincronização LMS",
      "default": "0"
    },
    {
      "fieldname": "lms_sync_frequency",
      "fieldtype": "Select",
      "label": "Frequência LMS",
      "options": "Daily\nEvery scheduler tick",
      "default": "Daily"
    },
    {
      "fieldname": "trivia_api_url",
      "fieldtype": "Data",
      "label": "URL da API da trivia360",
      "description": "Endpoint que recebe o payload normalizado de cursos existentes do LMS."
    },
    {
      "fieldname": "trivia_api_token",
      "fieldtype": "Password",
      "label": "Token da API da trivia360"
    },
    {
      "fieldname": "trivia_sync_mode",
      "fieldtype": "Select",
      "label": "Modo de envio",
      "options": "Push normalized payload\nDry run",
      "default": "Push normalized payload"
    },
    {
      "fieldname": "only_published",
      "fieldtype": "Check",
      "label": "Enviar somente cursos publicados",
      "default": "1"
    },
    {
      "fieldname": "audit_section",
      "fieldtype": "Section Break",
      "label": "Auditoria"
    },
    {
      "fieldname": "last_qapi_sync_at",
      "fieldtype": "Datetime",
      "label": "Última sincronização QAPI",
      "read_only": 1
    },
    {
      "fieldname": "last_lms_sync_at",
      "fieldtype": "Datetime",
      "label": "Última sincronização LMS",
      "read_only": 1
    },
    {
      "fieldname": "catalog_section",
      "fieldtype": "Section Break",
      "label": "Catálogos e recursos QAPI"
    },
    {
      "fieldname": "sync_catalogs",
      "fieldtype": "Check",
      "label": "Sincronizar catálogos",
      "default": "1"
    },
    {
      "fieldname": "sync_support_texts",
      "fieldtype": "Check",
      "label": "Sincronizar textos e vincular às questões",
      "default": "1"
    },
    {
      "fieldname": "sync_exams",
      "fieldtype": "Check",
      "label": "Sincronizar provas (200 cotas/chamada)",
      "default": "0"
    },
    {
      "fieldname": "sync_flashcards",
      "fieldtype": "Check",
      "label": "Sincronizar flashcards",
      "default": "1"
    },
    {
      "fieldname": "qapi_timeout",
      "fieldtype": "Int",
      "label": "Timeout HTTP (segundos)",
      "default": "60"
    },
    {
      "fieldname": "mcp_enabled",
      "fieldtype": "Check",
      "label": "Habilitar fallback MCP",
      "default": "0"
    },
    {
      "fieldname": "mcp_base_url",
      "fieldtype": "Data",
      "label": "MCP base URL",
      "default": "https://qapi.otunac.com/mcp"
    },
    {
      "fieldname": "ai_section",
      "fieldtype": "Section Break",
      "label": "Adaptador IA · enriquecimento de questões"
    },
    {
      "fieldname": "ai_enabled",
      "fieldtype": "Check",
      "label": "Habilitar enriquecimento IA",
      "default": "0",
      "description": "O enriquecimento é opt-in e consome chamadas do provedor configurado."
    },
    {
      "fieldname": "ai_base_url",
      "fieldtype": "Data",
      "label": "URL base IA",
      "default": "https://api.openai.com/v1"
    },
    {
      "fieldname": "ai_api_key",
      "fieldtype": "Password",
      "label": "Chave do provedor IA",
      "description": "Nunca exponha esta chave no frontend ou no repositório."
    },
    {
      "fieldname": "ai_model",
      "fieldtype": "Data",
      "label": "Modelo IA",
      "default": "gpt-6-luna"
    },
    {
      "fieldname": "ai_timeout",
      "fieldtype": "Int",
      "label": "Timeout IA (segundos)",
      "default": "90"
    },
    {
      "fieldname": "ai_batch_size",
      "fieldtype": "Int",
      "label": "Questões por execução IA",
      "default": "10",
      "description": "Limite de segurança por execução manual ou worker."
    },
    {
      "fieldname": "qapi_max_requests_per_run",
      "fieldtype": "Int",
      "label": "Máximo de créditos QAPI por execução",
      "default": "0",
      "description": "0 bloqueia chamadas pagas. Chamadas de provas custam 200 créditos; as demais custam 1. A reserva é descontada deste limite."
    },
    {
      "fieldname": "qapi_min_credit_reserve",
      "fieldtype": "Int",
      "label": "Reserva mínima de créditos QAPI",
      "default": "1",
      "description": "Créditos que o limite configurado mantém reservados e não gasta na execução."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "Trivia Editor",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trivia Reviewer",
      "read": 1,
      "write": 1,
      "create": 0
    }
  ]
}
