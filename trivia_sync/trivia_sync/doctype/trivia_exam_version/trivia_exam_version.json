    {"fieldname": "lesson", "fieldtype": "Link", "label": "Aula LMS", "options": "Course Lesson"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Estado", "options": "Ready\nPublished\nSuperseded\nArchived", "default": "Ready", "reqd": 1},
    {"fieldname": "published_at", "fieldtype": "Datetime", "label": "Publicado em"}
  ],
  "permissions": []
}
