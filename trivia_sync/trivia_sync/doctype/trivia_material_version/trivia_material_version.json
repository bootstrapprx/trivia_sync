{
  "doctype": "DocType",
  "name": "Trivia Material Version",
  "module": "Trivia Sync",
  "field_order": [
    "level",
    "version",
    "origin",
    "status",
    "content",
    "summary",
    "source_hash",
    "source_keys",
    "model",
    "submitted_by",
    "submitted_at",
    "approved_by",
    "approved_at",
    "rejected_by",
    "rejected_at",
    "review_reason",
    "published_at",
    "unpublished_at",
    "archived_at",
    "exported_file",
    "exported_file_url"
  ],
  "fields": [
    {
      "fieldname": "level",
      "fieldtype": "Select",
      "label": "Level",
      "options": "mais\n180\n360",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "version",
      "fieldtype": "Int",
      "label": "Version",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "origin",
      "fieldtype": "Select",
      "label": "Origin",
      "options": "AI\nManual",
      "default": "AI",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPending Approval\nApproved\nRejected\nPublished\nSuperseded\nStale\nArchived",
      "default": "Draft",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "content",
      "fieldtype": "Text Editor",
      "label": "Content",
      "reqd": 1
    },
    {
      "fieldname": "summary",
      "fieldtype": "Small Text",
      "label": "Summary"
    },
    {
      "fieldname": "source_hash",
      "fieldtype": "Data",
      "label": "Source hash",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "source_keys",
      "fieldtype": "Code",
      "label": "Source identities",
      "options": "JSON",
      "read_only": 1
    },
    {
      "fieldname": "model",
      "fieldtype": "Data",
      "label": "Model",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "submitted_by",
      "fieldtype": "Link",
      "label": "Submitted by",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "submitted_at",
      "fieldtype": "Datetime",
      "label": "Submitted at",
      "read_only": 1
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved by",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_at",
      "fieldtype": "Datetime",
      "label": "Approved at",
      "read_only": 1
    },
    {
      "fieldname": "rejected_by",
      "fieldtype": "Link",
      "label": "Rejected by",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "rejected_at",
      "fieldtype": "Datetime",
      "label": "Rejected at",
      "read_only": 1
    },
    {
      "fieldname": "review_reason",
      "fieldtype": "Small Text",
      "label": "Review reason"
    },
    {
      "fieldname": "published_at",
      "fieldtype": "Datetime",
      "label": "Published at",
      "read_only": 1
    },
    {
      "fieldname": "unpublished_at",
      "fieldtype": "Datetime",
      "label": "Unpublished at",
      "read_only": 1
    },
    {
      "fieldname": "archived_at",
      "fieldtype": "Datetime",
      "label": "Archived at",
      "read_only": 1
    },
    {
      "fieldname": "exported_file",
      "fieldtype": "Data",
      "label": "Exported file",
      "read_only": 1
    },
    {
      "fieldname": "exported_file_url",
      "fieldtype": "Data",
      "label": "Exported file URL",
      "read_only": 1
    }
  ],
  "istable": 1,
  "track_changes": 1,
  "permissions": []
}
