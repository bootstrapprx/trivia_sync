{
  "doctype": "DocType",
  "name": "Trivia Material Version",
  "module": "Trivia Sync",
  "field_order": [
    "level",
    "version",
    "content",
    "summary",
    "source_hash",
    "source_keys",
    "model",
    "status",
    "approved_by",
    "approved_at",
    "review_reason",
    "published_at"
  ],
  "fields": [
    {
      "fieldname": "level",
      "fieldtype": "Select",
      "label": "Level",
      "options": "mais\n180\n360",
      "reqd": 1
    },
    {
      "fieldname": "version",
      "fieldtype": "Int",
      "label": "Version",
      "reqd": 1
    },
    {
      "fieldname": "content",
      "fieldtype": "Text Editor",
      "label": "Content",
      "reqd": 1
    },
    {
      "fieldname": "summary",
      "fieldtype": "Small Text",
      "label": "Summary"
    },
    {
      "fieldname": "source_hash",
      "fieldtype": "Data",
      "label": "Source hash",
      "reqd": 1
    },
    {
      "fieldname": "source_keys",
      "fieldtype": "Code",
      "label": "Source identities",
      "options": "JSON"
    },
    {
      "fieldname": "model",
      "fieldtype": "Data",
      "label": "Model",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nApproved\nPublished\nStale",
      "default": "Draft",
      "reqd": 1
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved by",
      "options": "User"
    },
    {
      "fieldname": "approved_at",
      "fieldtype": "Datetime",
      "label": "Approved at"
    },
    {
      "fieldname": "review_reason",
      "fieldtype": "Small Text",
      "label": "Approval reason"
    },
    {
      "fieldname": "published_at",
      "fieldtype": "Datetime",
      "label": "Published at"
    }
  ],
  "istable": 1,
  "track_changes": 1,
  "permissions": []
}
