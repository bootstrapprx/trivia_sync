      "label": "Classificação relacionada"
    },
    {
      "fieldname": "trivia_banca",
      "fieldtype": "Link",
      "label": "Banca relacionada",
      "options": "Banca"
    },
    {
      "fieldname": "trivia_orgao",
      "fieldtype": "Link",
      "label": "Órgão relacionado",
      "options": "Órgão"
    },
    {
      "fieldname": "trivia_cargo",
      "fieldtype": "Link",
      "label": "Cargo de catálogo",
      "options": "Cargo"
    },
    {
      "fieldname": "concurso",
      "fieldtype": "Link",
      "label": "Concurso",
      "options": "Concurso"
    },
    {
      "fieldname": "concurso_cargo",
      "fieldtype": "Link",
      "label": "Cargo no concurso",
      "options": "Concurso Cargo"
    },
    {
      "fieldname": "prova",
      "fieldtype": "Link",
      "label": "Prova de origem",
      "options": "Prova"
    },
    {
      "fieldname": "trivia_materia",
      "fieldtype": "Link",
      "label": "Matéria relacionada",
      "options": "Matéria"
    },
    {
      "fieldname": "trivia_assunto",
      "fieldtype": "Link",
      "label": "Assunto relacionado",
      "options": "Assunto"
    },
    {
      "fieldname": "conteudos_programaticos",
