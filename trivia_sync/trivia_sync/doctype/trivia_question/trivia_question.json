{
  "doctype": "DocType",
  "name": "Trivia Question",
  "autoname": "field:qcode",
  "module": "Trivia Sync",
  "title_field": "enunciado",
  "track_changes": 1,
  "field_order": [
    "identity_section",
    "qcode",
    "source",
    "enunciado",
    "metadata_section",
    "banca",
    "orgao",
    "cargo",
    "ano",
    "materia",
    "assunto",
    "options",
    "correct_option",
    "explanation",
    "source_url",
    "raw_payload",
    "sync_hash",
    "last_synced_at"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "fieldtype": "Section Break",
      "label": "Identidade"
    },
    {
      "fieldname": "qcode",
      "fieldtype": "Data",
      "label": "Código da questão",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "source",
      "fieldtype": "Select",
      "label": "Fonte",
      "options": "QAPI\nManual",
      "default": "QAPI",
      "read_only": 1
    },
    {
      "fieldname": "enunciado",
      "fieldtype": "Text Editor",
      "label": "Enunciado",
      "reqd": 1
    },
    {
      "fieldname": "metadata_section",
      "fieldtype": "Section Break",
      "label": "Classificação"
    },
    {
      "fieldname": "banca",
      "fieldtype": "Data",
      "label": "Banca",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "orgao",
      "fieldtype": "Data",
      "label": "Órgão",
      "in_standard_filter": 1
    },
    {
      "fieldname": "cargo",
      "fieldtype": "Data",
      "label": "Cargo",
      "in_standard_filter": 1
    },
    {
      "fieldname": "ano",
      "fieldtype": "Int",
      "label": "Ano",
      "in_standard_filter": 1
    },
    {
      "fieldname": "materia",
      "fieldtype": "Data",
      "label": "Matéria",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "assunto",
      "fieldtype": "Data",
      "label": "Assunto",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "options",
      "fieldtype": "Code",
      "label": "Alternativas JSON",
      "options": "JSON"
    },
    {
      "fieldname": "correct_option",
      "fieldtype": "Select",
      "label": "Gabarito",
      "options": "A\nB\nC\nD\nE"
    },
    {
      "fieldname": "explanation",
      "fieldtype": "Text Editor",
      "label": "Comentário / explicação"
    },
    { "fieldname": "source_url", "fieldtype": "Data", "label": "URL da fonte" },
    {
      "fieldname": "raw_payload",
      "fieldtype": "Code",
      "label": "Payload bruto",
      "options": "JSON",
      "hidden": 1
    },
    {
      "fieldname": "sync_hash",
      "fieldtype": "Data",
      "label": "Hash de sincronização",
      "hidden": 1
    },
    {
      "fieldname": "last_synced_at",
      "fieldtype": "Datetime",
      "label": "Última sincronização",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
