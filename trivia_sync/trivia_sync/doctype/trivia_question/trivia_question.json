    {
      "fieldname": "projection_section",
      "fieldtype": "Section Break",
      "label": "Projeção para o LMS"
    },
    {
      "fieldname": "lms_question",
      "fieldtype": "Link",
      "label": "Questão LMS",
      "options": "LMS Question",
