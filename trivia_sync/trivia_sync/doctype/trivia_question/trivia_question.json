      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trivia Reviewer",
      "read": 1,
      "write": 1,
      "create": 0
    },
    {
      "role": "Trivia Integrator",
      "read": 1,
      "write": 1,
      "create": 0
    }
