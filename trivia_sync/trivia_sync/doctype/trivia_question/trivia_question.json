      "in_standard_filter": 1
    },
    {
      "fieldname": "reviewed_by",
      "fieldtype": "Link",
      "label": "Revisado por",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "reviewed_at",
      "fieldtype": "Datetime",
      "label": "Revisado em",
      "read_only": 1
    },
    {
      "fieldname": "review_reason",
      "fieldtype": "Small Text",
      "label": "Motivo da decisão"
    },
    {
      "fieldname": "editorial_notes",
      "fieldtype": "Text Editor",
      "label": "Notas editoriais"
    },
    {
      "fieldname": "source_license",
      "fieldtype": "Data",
      "label": "Licença declarada pela fonte"
    },
    {
      "fieldname": "source_attribution",
      "fieldtype": "Small Text",
      "label": "Atribuição exigida"
    },
    {
      "fieldname": "redistribution_status",
      "fieldtype": "Select",
      "label": "Direito de redistribuição",
      "options": "Pending\nApproved\nRejected",
